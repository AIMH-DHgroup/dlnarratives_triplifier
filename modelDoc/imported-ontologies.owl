    <owl:Class rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q1_occupied">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    </owl:Class>
    


