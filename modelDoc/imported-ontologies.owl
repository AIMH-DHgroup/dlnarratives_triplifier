    <!-- http://erlangen-crm.org/current/E4_Period -->

    <owl:Class rdf:about="http://erlangen-crm.org/current/E4_Period">
        <rdfs:subClassOf rdf:resource="http://erlangen-crm.org/current/E2_Temporal_Entity"/>
        <rdfs:subClassOf rdf:resource="http://erlangen-crm.org/current/E92_Spacetime_Volume"/>
        <rdfs:subClassOf rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP1_Phenomenal_Spacetime_Volume"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://erlangen-crm.org/current/P7_took_place_at"/>
                <owl:someValuesFrom rdf:resource="http://erlangen-crm.org/current/E53_Place"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://erlangen-crm.org/current/E52_Time-Span -->

    <owl:Class rdf:about="http://erlangen-crm.org/current/E52_Time-Span">
        <rdfs:subClassOf rdf:resource="http://erlangen-crm.org/current/E1_CRM_Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://erlangen-crm.org/current/P4i_is_time-span_of"/>
                <owl:someValuesFrom rdf:resource="http://erlangen-crm.org/current/E2_Temporal_Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://erlangen-crm.org/current/P83_had_at_least_duration"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://erlangen-crm.org/current/P84_had_at_most_duration"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://erlangen-crm.org/current/E53_Place -->

    <owl:Class rdf:about="http://erlangen-crm.org/current/E53_Place">
        <rdfs:subClassOf rdf:resource="http://erlangen-crm.org/current/E1_CRM_Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://erlangen-crm.org/current/P59i_is_located_on_or_within"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
