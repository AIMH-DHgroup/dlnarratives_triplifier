        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Scope note:	This property defines the coordinate reference system in terms of which a geometric place expression is formulated.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q9i_terms_express -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q9i_terms_express">
